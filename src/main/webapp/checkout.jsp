<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="fragments/header.jsp" %><%@ include file="fragments/navbar.jsp" %><main class="container py-5"><span class="eyebrow">ALMOST THERE</span><h1 class="section-title mb-4">Delivery & checkout</h1><div class="row g-4"><div class="col-lg-7"><div class="panel"><h3>Delivery address</h3><c:if test="${not empty error}"><div class="alert alert-danger">${error}</div></c:if><form method="post" action="${pageContext.request.contextPath}/checkout"><label class="form-label">Address</label><input class="form-control mb-3" name="address" required><div class="row"><div class="col-md-6"><label class="form-label">City</label><input class="form-control mb-3" name="city" required></div><div class="col-md-6"><label class="form-label">State</label><input class="form-control mb-3" name="state" required></div></div><label class="form-label">PIN code</label><input class="form-control mb-3" name="pincode" required pattern="[0-9]{6}"><label class="form-label">Payment method</label><input class="form-control mb-4" value="Cash on Delivery (demo)" readonly><button class="btn btn-dark btn-lg w-100">Place order</button></form></div></div><div class="col-lg-5"><div class="panel"><h3>Order summary</h3><c:forEach var="i" items="${cartItems}"><div class="d-flex justify-content-between py-2"><span>${i.product.name} × ${i.quantity}</span><strong>₹${i.subtotal}</strong></div></c:forEach><hr><p class="text-muted small">This is a demo checkout. No real payment is collected.</p></div></div></div></main><%@ include file="fragments/footer.jsp" %>
