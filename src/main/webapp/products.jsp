<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="fragments/header.jsp" %><%@ include file="fragments/navbar.jsp" %>
<main class="container py-4"><section class="hero mb-5"><div class="hero-copy"><span class="eyebrow">THE EVERYDAY EDIT</span><h1>Find your next<br><span>favourite thing.</span></h1><p>Good design, useful essentials, and little upgrades for everyday life.</p><a href="#catalog" class="btn btn-dark btn-lg">Explore collection</a></div><div class="hero-art"><div class="hero-orb"></div><div class="hero-card"><span>CURATED FOR YOU</span><strong>Small joys.<br>Big difference.</strong><span class="hero-star">✦</span></div></div></section>
<div class="d-flex justify-content-between align-items-end mb-3" id="catalog"><div><span class="eyebrow">OUR COLLECTION</span><h2 class="section-title">Popular right now</h2></div><span class="text-muted">${products.size()} products</span></div>
<c:if test="${empty products}"><div class="alert alert-info">No products found. Try a different search.</div></c:if>
<div class="row g-4"><c:forEach var="p" items="${products}"><div class="col-6 col-lg-3"><article class="product-card h-100"><a href="${pageContext.request.contextPath}/product?id=${p.productId}" class="product-image-wrap"><img class="product-image" src="${empty p.imageUrl ? 'https://placehold.co/600x450?text=ShopSphere' : p.imageUrl}" alt="${p.name}" onerror="this.src='https://placehold.co/600x450?text=ShopSphere'"><c:if test="${p.discount gt 0}"><span class="discount-pill">${p.discount}% OFF</span></c:if></a><div class="p-3"><small class="text-muted">${p.brand}</small><h3 class="product-name"><a href="${pageContext.request.contextPath}/product?id=${p.productId}">${p.name}</a></h3><div class="price-line"><strong>₹<c:out value="${p.finalPrice}"/></strong><c:if test="${p.discount gt 0}"><del>₹${p.price}</del></c:if></div><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="id" value="${p.productId}"><button class="btn btn-outline-dark w-100 mt-3" ${p.stock le 0 ? 'disabled' : ''}>Add to cart</button></form></div></article></div></c:forEach></div>
</main><%@ include file="fragments/footer.jsp" %>
