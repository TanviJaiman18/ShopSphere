<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="fragments/header.jsp" %><%@ include file="fragments/navbar.jsp" %>
<main class="container py-5"><div class="row g-5 align-items-center"><div class="col-md-6"><img class="detail-image" src="${empty product.imageUrl ? 'https://placehold.co/700x600?text=ShopSphere' : product.imageUrl}" alt="${product.name}" onerror="this.src='https://placehold.co/700x600?text=ShopSphere'"></div><div class="col-md-6"><span class="eyebrow">${product.brand}</span><h1 class="display-5 fw-bold mt-2">${product.name}</h1><p class="text-muted">${product.description}</p><h2 class="my-4">₹${product.finalPrice} <c:if test="${product.discount gt 0}"><del class="fs-5 text-muted">₹${product.price}</del><span class="text-success fs-6 ms-2">${product.discount}% off</span></c:if></h2><p>${product.stock gt 0 ? 'In stock' : 'Out of stock'} · ${product.stock} available</p><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="id" value="${product.productId}"><button class="btn btn-dark btn-lg" ${product.stock le 0 ? 'disabled' : ''}>Add to cart</button><a class="btn btn-outline-secondary btn-lg ms-2" href="${pageContext.request.contextPath}/">Continue shopping</a></form></div></div></main>
<%@ include file="fragments/footer.jsp" %>
